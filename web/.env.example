# Local development values. Copy to .env.local (git-ignored) and fill in.
# `npm run dev` reads this file; `npm run build` reads .env.production instead, which is
# committed and holds the values for https://auth.sike.dev (public values only).
# Never put the Supabase secret key in this app.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Comma-separated app origins that /logout?return_to=… may send users back to.
VITE_LOGOUT_RETURN_ORIGINS=
