# Production build values for https://auth.sike.dev (read by `vite build`).
# This file is committed on purpose, so it may hold PUBLIC values only: they end up in the
# site's JavaScript. Never add the Supabase secret key, an access token or the Resend key.
# A test (src/lib/env-production.test.ts) fails if a secret-looking value is added.
# Variables set in the host's dashboard override this file.

VITE_SUPABASE_URL=https://vrhninehaoacydhvuvxk.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_m0F4M2Q0Cm3R82bINahoVQ_5WIEEYiq

# Comma-separated https origins of your apps that /logout?return_to=... may send users back to.
# Empty means no app is allowed yet. Example: https://app.sike.dev,https://www.sike.dev
VITE_LOGOUT_RETURN_ORIGINS=
