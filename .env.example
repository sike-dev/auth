# Admin-only values for scripts in supabase/. Copy to .env (git-ignored) and fill in.
# The web app has its own public-only files: web/.env.example (local) and
# web/.env.production (committed, for https://auth.sike.dev).
# Never commit real values, and never put these in web/ or in any app.

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Used by supabase/apply-email-config.mjs
SUPABASE_ACCESS_TOKEN=
RESEND_API_KEY=
# Optional, these are the defaults
# MAIL_FROM=no-reply@mail.sike.dev
# MAIL_FROM_NAME=Sike
